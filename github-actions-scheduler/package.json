{
  "name": "github-actions-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that triggers Jobs-scraping-tool GitHub Actions workflows on an IST schedule.",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "secret": "wrangler secret put GITHUB_TOKEN"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
